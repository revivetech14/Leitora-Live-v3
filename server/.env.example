# Salin file ini jadi ".env" lalu isi dengan kredensial LiveKit kamu
# Ambil di LiveKit Cloud dashboard: https://cloud.livekit.io

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

PORT=3001

# Password buat siapapun yang mau bikin/mulai siaran sebagai HOST
# (peserta biasa TIDAK butuh ini, cukup buka link)
HOST_PASSWORD=ganti-dengan-password-host
